<Window x:Class="RecordKeeper.App.Views.PasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        Title="Password"
        Width="640" Height="520"
        MinWidth="520" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        FontSize="{DynamicResource App.FontSize}"
        Background="{DynamicResource App.Background}"
        Foreground="{DynamicResource App.Foreground}">

    <DockPanel Margin="20">

        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <TextBlock x:Name="HeadingText"
                       Style="{StaticResource PageHeading}"
                       automation:AutomationProperties.HeadingLevel="Level1" />
            <Border Style="{StaticResource Brand.AccentRule}" />
            <TextBlock x:Name="IntroText"
                       Style="{StaticResource InfoText}"
                       Margin="0,12,0,0" />
        </StackPanel>

        <Border DockPanel.Dock="Bottom"
                BorderBrush="{DynamicResource App.Border}"
                BorderThickness="0,1,0,0"
                Margin="0,16,0,0"
                Padding="0,14,0,0">
            <DockPanel LastChildFill="False">
                <Button x:Name="OkButton"
                        DockPanel.Dock="Left"
                        Style="{StaticResource PrimaryButton}"
                        IsDefault="True"
                        MinWidth="150" />
                <Button x:Name="CancelButton" Content="_Cancel"
                        DockPanel.Dock="Left"
                        IsCancel="True" />
            </DockPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
            <StackPanel Margin="0,0,14,0">

                <Label Target="{Binding ElementName=FirstBox}" x:Name="FirstLabel" />
                <PasswordBox x:Name="FirstBox" Margin="0,0,0,14"
                             Padding="10,5"
                             MinHeight="{StaticResource App.ControlHeight}" />

                <StackPanel x:Name="ConfirmPanel">
                    <Label Target="{Binding ElementName=SecondBox}" Content="Type the password _again" />
                    <PasswordBox x:Name="SecondBox" Margin="0,0,0,14"
                                 Padding="10,5"
                                 MinHeight="{StaticResource App.ControlHeight}"
                                 automation:AutomationProperties.Name="Type the password again"
                                 automation:AutomationProperties.HelpText="Both boxes must match. There is no way to recover a password that is mistyped in both." />
                </StackPanel>

                <CheckBox x:Name="ShowPasswordBox"
                          Content="Show the password as I type"
                          Margin="0,0,0,14"
                          automation:AutomationProperties.Name="Show the password as I type"
                          automation:AutomationProperties.HelpText="Useful with a magnifier. The password is shown in plain text while this is ticked." />

                <TextBox x:Name="VisibleFirstBox"
                         Visibility="Collapsed"
                         Margin="0,0,0,14"
                         automation:AutomationProperties.Name="Password, shown as plain text" />

                <TextBox x:Name="VisibleSecondBox"
                         Visibility="Collapsed"
                         Margin="0,0,0,14"
                         automation:AutomationProperties.Name="Password again, shown as plain text" />

                <TextBlock x:Name="MessageText"
                           Style="{StaticResource ErrorText}"
                           Visibility="Collapsed"
                           Margin="0,0,0,14"
                           automation:AutomationProperties.LiveSetting="Assertive" />

                <Border x:Name="WarningPanel" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Before you turn this on"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource App.HeadingForeground}"
                                   Margin="0,0,0,8" />
                        <TextBlock Style="{StaticResource FieldHelpText}">
                            There is no way to recover a forgotten password. Nobody can unlock the database for you, and neither can this application. If you lose it, the records are gone.
                        </TextBlock>
                        <TextBlock Style="{StaticResource FieldHelpText}" Margin="0,8,0,0">
                            Attached files are not encrypted. Only the database is. Anything you have attached stays readable in the attachments folder.
                        </TextBlock>
                        <TextBlock Style="{StaticResource FieldHelpText}" Margin="0,8,0,0">
                            A copy of the database as it is now is kept alongside it, so nothing is lost if the change goes wrong. Delete that copy once you are happy, or it defeats the point.
                        </TextBlock>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
