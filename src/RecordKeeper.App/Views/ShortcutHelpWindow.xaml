<Window x:Class="RecordKeeper.App.Views.ShortcutHelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        Title="Keyboard shortcuts"
        Width="820" Height="640"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontSize="{DynamicResource App.FontSize}"
        Background="{DynamicResource App.Background}"
        Foreground="{DynamicResource App.Foreground}">

    <Window.Resources>
        <Style x:Key="ShortcutItemStyle" TargetType="ListBoxItem"
               BasedOn="{StaticResource {x:Type ListBoxItem}}">
            <Setter Property="automation:AutomationProperties.Name" Value="{Binding AccessibleName}" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Text="Keyboard shortcuts"
                       Style="{StaticResource PageHeading}"
                       automation:AutomationProperties.HeadingLevel="Level1" />
            <Border Style="{StaticResource Brand.AccentRule}" />
            <TextBlock Text="Everything in acvayrecords can be done from the keyboard. Use the arrow keys to read through this list."
                       Style="{StaticResource InfoText}"
                       Margin="0,12,0,12" />

            <Label Target="{Binding ElementName=FilterBox}" Content="_Filter the list" />
            <TextBox x:Name="FilterBox"
                     automation:AutomationProperties.Name="Filter the shortcut list"
                     automation:AutomationProperties.HelpText="Type a word to show only matching commands, for example delete or export." />
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="CopyButton" Content="Copy all to clip_board" MinWidth="200" />
            <Button x:Name="CloseButton" Content="_Close" IsDefault="True" IsCancel="True" Margin="0" />
        </StackPanel>

        <ListBox x:Name="ShortcutList"
                 ItemContainerStyle="{StaticResource ShortcutItemStyle}"
                 automation:AutomationProperties.Name="Commands and their shortcuts">
            <ListBox.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}"
                                       FontWeight="Bold"
                                       FontSize="{DynamicResource App.FontSize.Heading}"
                                       Margin="0,14,0,6"
                                       automation:AutomationProperties.HeadingLevel="Level2" />
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </ListBox.GroupStyle>

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding Name}" Style="{StaticResource RowPrimaryText}" />
                            <TextBlock Text="{Binding Description}"
                                       Style="{StaticResource RowSecondaryText}"
                                       Margin="0,3,0,0" />
                        </StackPanel>

                        <TextBlock Grid.Column="1" Text="{Binding Shortcut}"
                                   Style="{StaticResource RowAccentText}"
                                   VerticalAlignment="Top" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
