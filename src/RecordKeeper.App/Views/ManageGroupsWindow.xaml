<Window x:Class="RecordKeeper.App.Views.ManageGroupsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        xmlns:app="clr-namespace:RecordKeeper.App"
        Title="Groups"
        Width="760" Height="680"
        MinWidth="620" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontSize="{DynamicResource App.FontSize}"
        Background="{DynamicResource App.Background}"
        Foreground="{DynamicResource App.Foreground}">

    <Window.Resources>
        <app:NotEmptyToVisibilityConverter x:Key="NotEmptyToVisible" />

        <Style x:Key="GroupItemStyle" TargetType="ListBoxItem"
               BasedOn="{StaticResource {x:Type ListBoxItem}}">
            <Setter Property="automation:AutomationProperties.Name" Value="{Binding AccessibleName}" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="20">

        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <TextBlock Text="Groups"
                       Style="{StaticResource PageHeading}"
                       automation:AutomationProperties.HeadingLevel="Level1" />
            <Border Style="{StaticResource Brand.AccentRule}" />
            <TextBlock Text="A group gathers categories that belong together, such as Online trading. Any field marked as an expense is added up across the whole group."
                       Style="{StaticResource InfoText}"
                       Margin="0,12,0,0" />
        </StackPanel>

        <Border DockPanel.Dock="Bottom"
                BorderBrush="{DynamicResource App.Border}"
                BorderThickness="0,1,0,0"
                Margin="0,16,0,0"
                Padding="0,14,0,0">
            <DockPanel LastChildFill="False">
                <Button x:Name="CloseButton" Content="_Close"
                        DockPanel.Dock="Right"
                        IsDefault="True" IsCancel="True"
                        Margin="0" />
            </DockPanel>
        </Border>

        <!-- Add a group. -->
        <Border DockPanel.Dock="Top"
                Style="{StaticResource Card}"
                Padding="14"
                Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Add a group: type a name and press Enter."
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource App.HeadingForeground}"
                           Margin="0,0,0,9" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MaxWidth="360" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="NewGroupNameBox" Grid.Column="0"
                             automation:AutomationProperties.Name="New group name"
                             automation:AutomationProperties.HelpText="Type a name for a new group, then press Enter." />

                    <Button x:Name="AddGroupButton" Grid.Column="2"
                            Content="_Add group"
                            Style="{StaticResource PrimaryButton}"
                            MinWidth="130"
                            Margin="0" />
                </Grid>
            </StackPanel>
        </Border>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,14,0,0">
            <Button x:Name="RenameGroupButton" Content="_Rename" MinWidth="120" />
            <Button x:Name="DeleteGroupButton" Content="_Delete group" MinWidth="150" Margin="0"
                    automation:AutomationProperties.HelpText="Deletes the group only. Its categories and all their records are kept, and simply become ungrouped." />
        </StackPanel>

        <Grid>
        <TextBlock x:Name="NoGroupsText"
                   Style="{StaticResource InfoText}"
                   VerticalAlignment="Top"
                   Visibility="Collapsed"
                   Text="No groups yet. Type a name above and press Enter to make one, then put categories into it from the Categories and their fields window." />

        <ListBox x:Name="GroupList"
                 ItemContainerStyle="{StaticResource GroupItemStyle}"
                 automation:AutomationProperties.Name="Groups"
                 automation:AutomationProperties.HelpText="Use the up and down arrow keys to choose a group.">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <TextBlock Text="{Binding Name}" Style="{StaticResource RowPrimaryText}" />
                        <TextBlock Text="{Binding Summary}" Style="{StaticResource RowSecondaryText}"
                                   Margin="0,2,0,0" />
                        <TextBlock Text="{Binding ExpenseLine}" Style="{StaticResource RowSecondaryText}"
                                   Visibility="{Binding ExpenseLine, Converter={StaticResource NotEmptyToVisible}}"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        </Grid>
    </DockPanel>
</Window>
