<Window x:Class="RecordKeeper.App.Views.RecordTypeEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        xmlns:app="clr-namespace:RecordKeeper.App"
        Title="Categories and their fields"
        Width="1180" Height="840"
        MinWidth="900" MinHeight="620"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontSize="{DynamicResource App.FontSize}"
        Background="{DynamicResource App.Background}"
        Foreground="{DynamicResource App.Foreground}">

    <Window.Resources>
        <app:NotEmptyToVisibilityConverter x:Key="NotEmptyToVisible" />

        <Style x:Key="FieldItemStyle" TargetType="ListBoxItem"
               BasedOn="{StaticResource {x:Type ListBoxItem}}">
            <Setter Property="automation:AutomationProperties.Name" Value="{Binding Name}" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="20">

        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <TextBlock Text="Categories and their fields"
                       Style="{StaticResource PageHeading}"
                       automation:AutomationProperties.HeadingLevel="Level1" />
            <Border Style="{StaticResource Brand.AccentRule}" />
            <TextBlock Text="A category is a kind of record, together with the fields its records hold. Press F6 to move between the category list and the details."
                       Style="{StaticResource InfoText}"
                       Margin="0,12,0,0" />
        </StackPanel>

        <Border DockPanel.Dock="Bottom"
                BorderBrush="{DynamicResource App.Border}"
                BorderThickness="0,1,0,0"
                Margin="0,16,0,0"
                Padding="0,14,0,0">
            <DockPanel LastChildFill="False">
                <Button x:Name="SaveTypeButton" Content="_Save this category"
                        DockPanel.Dock="Left"
                        Style="{StaticResource PrimaryButton}"
                        MinWidth="190" />
                <Button x:Name="CloseButton" Content="_Close"
                        DockPanel.Dock="Right"
                        IsCancel="True"
                        Margin="0" />
            </DockPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" MinWidth="230" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ================= The categories ================= -->
            <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top" Text="Categories"
                           Style="{StaticResource HeadingText}"
                           automation:AutomationProperties.HeadingLevel="Level2" />

                <StackPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">

                    <!-- Which group the selected category belongs to. -->
                    <Label Target="{Binding ElementName=CategoryGroupBox}" Content="_Group for this category" />
                    <ComboBox x:Name="CategoryGroupBox" Margin="0,0,0,8"
                              automation:AutomationProperties.Name="Group for this category"
                              automation:AutomationProperties.HelpText="Use the up and down arrow keys. Expense fields are totalled across every category in the same group." />

                    <Button x:Name="ManageGroupsButton" Content="Manage gr_oups"
                            HorizontalAlignment="Stretch"
                            Margin="0,0,0,16"
                            automation:AutomationProperties.HelpText="Add, rename or delete groups. Deleting a group never deletes categories or records." />

                    <Button x:Name="AddTypeButton" Content="_New category"
                            Style="{StaticResource PrimaryButton}"
                            HorizontalAlignment="Stretch"
                            Margin="0,0,0,8"
                            automation:AutomationProperties.HelpText="Opens a short form to name a new category. Shortcut Control plus Shift plus N." />
                    <Button x:Name="DuplicateTypeButton" Content="D_uplicate this category"
                            HorizontalAlignment="Stretch"
                            Margin="0,0,0,8"
                            automation:AutomationProperties.HelpText="Creates a copy with the same fields, which you can then change. The original is not touched." />
                    <Button x:Name="DeleteTypeButton" Content="_Delete this category"
                            HorizontalAlignment="Stretch"
                            Margin="0"
                            automation:AutomationProperties.HelpText="Only possible while no record uses the category." />
                </StackPanel>

                <ListBox x:Name="TypeList"
                         Style="{StaticResource PlainList}"
                         VerticalAlignment="Top"
                         DisplayMemberPath="Name"
                         automation:AutomationProperties.Name="Categories"
                         automation:AutomationProperties.HelpText="Use the up and down arrow keys to choose a category to edit." />
            </DockPanel>

            <!-- ================= The selected category ================= -->
            <DockPanel x:Name="DetailsPanel" Grid.Column="2">

                <!-- What the category is called. -->
                <!--
                    All three on one row. This section used to stack them and ate most of
                    the window, leaving the field list - the thing people actually come
                    here to work on - about two lines tall.
                -->
                <GroupBox DockPanel.Dock="Top" Header="About this category">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="1.3*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <Label Target="{Binding ElementName=TypeNameBox}" Content="Category _name" />
                            <TextBox x:Name="TypeNameBox"
                                     automation:AutomationProperties.Name="Category name, required"
                                     automation:AutomationProperties.HelpText="What this kind of record is called, for example Invoice." />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <Label Target="{Binding ElementName=TitleLabelBox}" Content="_Identifying field" />
                            <TextBox x:Name="TitleLabelBox"
                                     automation:AutomationProperties.Name="Name of the identifying field"
                                     automation:AutomationProperties.HelpText="Every record has one required field that names it, shown in the list and searched first. For example Item, Worker name or Customer name. Leave empty to call it Title." />
                        </StackPanel>

                        <StackPanel Grid.Column="4">
                            <Label Target="{Binding ElementName=TypeDescriptionBox}" Content="_Description" />
                            <TextBox x:Name="TypeDescriptionBox"
                                     automation:AutomationProperties.Name="Description"
                                     automation:AutomationProperties.HelpText="A sentence saying what belongs in this category." />
                        </StackPanel>
                    </Grid>
                </GroupBox>

                <!-- The fields it holds. -->
                <GroupBox Header="Fields">
                    <DockPanel>

                        <TextBlock x:Name="FieldCountText"
                                   DockPanel.Dock="Top"
                                   Style="{StaticResource FieldHelpText}"
                                   Margin="0,0,0,10"
                                   automation:AutomationProperties.LiveSetting="Polite" />

                        <!--
                            Quick add. The point of this strip is that adding eight fields
                            should not mean opening eight dialogs: type a name, pick a
                            kind, press Enter, and the box is ready for the next one.
                            Anything beyond a name and a kind is set with Edit afterwards.
                        -->
                        <Border DockPanel.Dock="Top"
                                Style="{StaticResource Card}"
                                Padding="12"
                                Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Add a field: type a name, choose what it holds, press Enter."
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource App.HeadingForeground}"
                                           Margin="0,0,0,9" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" MaxWidth="320" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBox x:Name="QuickFieldNameBox" Grid.Column="0"
                                             automation:AutomationProperties.Name="New field name"
                                             automation:AutomationProperties.HelpText="Type the name of a field to add, then press Enter." />

                                    <ComboBox x:Name="QuickFieldKindBox" Grid.Column="2"
                                              MinWidth="210"
                                              automation:AutomationProperties.Name="What the new field holds"
                                              automation:AutomationProperties.HelpText="Use the up and down arrow keys. The choice is remembered for the next field you add." />

                                    <Button x:Name="QuickAddButton" Grid.Column="4"
                                            Content="_Add"
                                            Style="{StaticResource PrimaryButton}"
                                            MinWidth="96"
                                            Margin="0"
                                            automation:AutomationProperties.HelpText="Adds the field and clears the box for the next one." />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- What to do with the field that is selected. -->
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,14,0,0">
                            <Button x:Name="EditFieldButton" Content="_Edit field" MinWidth="120"
                                    automation:AutomationProperties.HelpText="Opens the full settings for the selected field: whether it is required, its options, its formula and its explanation." />
                            <Button x:Name="RemoveFieldButton" Content="_Remove" MinWidth="110" />
                            <Button x:Name="MoveFieldUpButton" Content="Move _up" MinWidth="110"
                                    automation:AutomationProperties.HelpText="Moves the field earlier, changing the order fields are read out in." />
                            <Button x:Name="MoveFieldDownButton" Content="Move dow_n" MinWidth="124" Margin="0"
                                    automation:AutomationProperties.HelpText="Moves the field later in the order." />
                        </StackPanel>

                        <ListBox x:Name="FieldList"
                                 MinHeight="200"
                                 ItemContainerStyle="{StaticResource FieldItemStyle}"
                                 automation:AutomationProperties.Name="Fields on this category"
                                 automation:AutomationProperties.HelpText="Use the arrow keys to choose a field, then Edit field to change it.">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource RowPrimaryText}" />
                                        <TextBlock Style="{StaticResource RowSecondaryText}" Margin="0,2,0,0">
                                            <Run Text="{Binding DataType, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock Style="{StaticResource RowSecondaryText}"
                                                   Visibility="{Binding Formula, Converter={StaticResource NotEmptyToVisible}}"
                                                   Margin="0,2,0,0">
                                            <Run Text="Worked out as " FontStyle="Italic" /><Run Text="{Binding Formula, Mode=OneWay}" FontStyle="Italic" />
                                        </TextBlock>
                                        <TextBlock Text="{Binding HelpText}"
                                                   Style="{StaticResource RowSecondaryText}"
                                                   Visibility="{Binding HelpText, Converter={StaticResource NotEmptyToVisible}}"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </GroupBox>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
