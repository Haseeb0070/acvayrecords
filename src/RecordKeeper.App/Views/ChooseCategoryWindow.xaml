<Window x:Class="RecordKeeper.App.Views.ChooseCategoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        Title="Which category?"
        Width="620" Height="560"
        MinWidth="520" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontSize="{DynamicResource App.FontSize}"
        Background="{DynamicResource App.Background}"
        Foreground="{DynamicResource App.Foreground}">

    <Window.Resources>
        <Style x:Key="CategoryItemStyle" TargetType="ListBoxItem"
               BasedOn="{StaticResource {x:Type ListBoxItem}}">
            <Setter Property="automation:AutomationProperties.Name" Value="{Binding AccessibleName}" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="20">

        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <TextBlock x:Name="HeadingText"
                       Style="{StaticResource PageHeading}"
                       automation:AutomationProperties.HeadingLevel="Level1" />
            <Border Style="{StaticResource Brand.AccentRule}" />
            <TextBlock x:Name="IntroText"
                       Style="{StaticResource InfoText}"
                       Margin="0,12,0,0" />
        </StackPanel>

        <Border DockPanel.Dock="Bottom"
                BorderBrush="{DynamicResource App.Border}"
                BorderThickness="0,1,0,0"
                Margin="0,16,0,0"
                Padding="0,14,0,0">
            <DockPanel LastChildFill="False">
                <Button x:Name="CancelButton" Content="Cance_l"
                        DockPanel.Dock="Right"
                        IsCancel="True"
                        MinWidth="120"
                        Margin="0" />
                <Button x:Name="ContinueButton" Content="_Continue"
                        DockPanel.Dock="Right"
                        Style="{StaticResource PrimaryButton}"
                        IsDefault="True"
                        MinWidth="160"
                        Margin="0,0,12,0" />
            </DockPanel>
        </Border>

        <!--
            The list takes whatever height is left over. A fixed window height is used
            rather than SizeToContent so that the Continue and Cancel buttons sit in the
            same place however many categories there are: a keyboard user who has learnt
            where a button is should not have to find it again.
        -->
        <ListBox x:Name="CategoryList"
                 Style="{StaticResource PlainList}"
                 ItemContainerStyle="{StaticResource CategoryItemStyle}"
                 automation:AutomationProperties.Name="Categories"
                 automation:AutomationProperties.HelpText="Use the up and down arrow keys to choose a category, then press Enter.">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <TextBlock Text="{Binding Name}" Style="{StaticResource RowPrimaryText}" />
                        <TextBlock Text="{Binding Summary}" Style="{StaticResource RowSecondaryText}"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
