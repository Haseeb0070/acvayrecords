<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        High contrast. Every brush comes from the Windows system palette rather than
        being hard-coded, so whichever high-contrast scheme the user has chosen in
        Windows Settings is the scheme the app uses. Overriding these with our own
        colours is exactly what breaks high-contrast mode in most applications, and it
        is why this theme still wins over the dark theme when Windows asks for it.
    -->

    <SolidColorBrush x:Key="App.Background"          Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="App.Foreground"          Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="App.PanelBackground"     Color="{x:Static SystemColors.ControlColor}" />
    <SolidColorBrush x:Key="App.PanelForeground"     Color="{x:Static SystemColors.ControlTextColor}" />

    <SolidColorBrush x:Key="App.SubtleForeground"    Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="App.InfoForeground"      Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="App.HeadingForeground"   Color="{x:Static SystemColors.WindowTextColor}" />

    <SolidColorBrush x:Key="App.Border"              Color="{x:Static SystemColors.ActiveBorderColor}" />

    <SolidColorBrush x:Key="App.ControlBackground"   Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="App.ControlForeground"   Color="{x:Static SystemColors.WindowTextColor}" />

    <SolidColorBrush x:Key="App.SelectionBackground" Color="{x:Static SystemColors.HighlightColor}" />
    <SolidColorBrush x:Key="App.SelectionForeground" Color="{x:Static SystemColors.HighlightTextColor}" />

    <!--
        No pale tint here. High contrast gets the system's full selection inversion,
        which is what a user who asked for high contrast expects everywhere.
    -->
    <SolidColorBrush x:Key="App.RowSelectionBackground" Color="{x:Static SystemColors.HighlightColor}" />
    <SolidColorBrush x:Key="App.RowSelectionForeground" Color="{x:Static SystemColors.HighlightTextColor}" />
    <SolidColorBrush x:Key="App.RowMarker"              Color="{x:Static SystemColors.HighlightTextColor}" />

    <SolidColorBrush x:Key="App.AccentBackground"    Color="{x:Static SystemColors.HighlightColor}" />
    <SolidColorBrush x:Key="App.AccentForeground"    Color="{x:Static SystemColors.HighlightTextColor}" />

    <SolidColorBrush x:Key="App.PrimaryButtonBackground" Color="{x:Static SystemColors.HighlightColor}" />
    <SolidColorBrush x:Key="App.PrimaryButtonForeground" Color="{x:Static SystemColors.HighlightTextColor}" />
    <SolidColorBrush x:Key="App.PrimaryButtonBorder"     Color="{x:Static SystemColors.WindowTextColor}" />

    <SolidColorBrush x:Key="App.ErrorForeground"     Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="App.RequiredForeground"  Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="App.SuccessForeground"   Color="{x:Static SystemColors.WindowTextColor}" />

    <SolidColorBrush x:Key="App.ScrollTrack"         Color="{x:Static SystemColors.ControlColor}" />
    <SolidColorBrush x:Key="App.ScrollThumb"         Color="{x:Static SystemColors.ControlTextColor}" />

</ResourceDictionary>
