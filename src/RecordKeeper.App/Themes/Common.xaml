<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!--
        Shared styles. Colours arrive as dynamic resources from whichever theme
        dictionary is loaded, and the three focus resources below are replaced at
        runtime from the user's settings so the outline can be made thicker or
        recoloured for low vision.
    -->

    <SolidColorBrush x:Key="App.FocusBrush" Color="#FFD400" />
    <sys:Double x:Key="App.FocusThickness">3</sys:Double>
    <Thickness x:Key="App.FocusBorderThickness">3</Thickness>

    <CornerRadius x:Key="App.CornerRadius">6</CornerRadius>
    <CornerRadius x:Key="App.CornerRadius.Large">10</CornerRadius>

    <!--
        One height for every single-line control, so a text box and the buttons beside
        it sit on the same line instead of almost doing so.

        It also stops the window twitching as you tab: the focus outline thickens the
        border from one pixel to three, and without a fixed minimum that grows the
        control and nudges everything around it.
    -->
    <sys:Double x:Key="App.ControlHeight">44</sys:Double>

    <!--
        The keyboard focus outline. WPF only draws this for keyboard focus, never for
        a mouse click, which is the behaviour a keyboard-only user wants. The negative
        margin pushes it just outside the control so it never hides the text.
    -->
    <Style x:Key="AccessibleFocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-3"
                               RadiusX="6" RadiusY="6"
                               SnapsToDevicePixels="True"
                               Stroke="{DynamicResource App.FocusBrush}"
                               StrokeThickness="{DynamicResource App.FocusThickness}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Text ===================== -->

    <!--
        No Foreground setter here on purpose. Leaving it to inherit from the window, and
        from a selected row, is what lets row text recolour itself when its row is
        highlighted. Styles that do need a specific colour set it explicitly below.
    -->
    <Style TargetType="TextBlock">
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
    </Style>

    <Style x:Key="PageHeading" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource App.HeadingForeground}" />
        <Setter Property="FontSize" Value="{DynamicResource App.FontSize.Heading}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="HeadingText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource App.HeadingForeground}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <Style x:Key="SubtleText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource App.SubtleForeground}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="InfoText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource App.InfoForeground}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!--
        The explanation under a field label. A notch smaller than body text, because
        every field carries one and at full size they add up to a wall of prose that
        competes with the values the user is actually reading.
    -->
    <Style x:Key="FieldHelpText" TargetType="TextBlock" BasedOn="{StaticResource SubtleText}">
        <Setter Property="FontSize" Value="{DynamicResource App.FontSize.Small}" />
    </Style>

    <Style x:Key="ErrorText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource App.ErrorForeground}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!--
        ===================== Row text =====================

        Text inside a selectable row needs to change colour when that row is
        highlighted, otherwise the light blue secondary text would sit on the blue
        selection block and disappear. These three styles read the parent row's
        selected state and switch to the selection foreground.
    -->

    <Style x:Key="RowPrimaryText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource App.Foreground}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                         Value="True">
                <Setter Property="Foreground" Value="{DynamicResource App.RowSelectionForeground}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="RowSecondaryText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource App.InfoForeground}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                         Value="True">
                <Setter Property="Foreground" Value="{DynamicResource App.RowSelectionForeground}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="RowAccentText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource App.HeadingForeground}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                         Value="True">
                <Setter Property="Foreground" Value="{DynamicResource App.RowSelectionForeground}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- A panel that groups content, used for the empty-state and summary blocks. -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource App.PanelBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource App.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource App.CornerRadius.Large}" />
        <Setter Property="Padding" Value="20" />
    </Style>

    <!-- Field labels sit in the secondary colour, the value itself in the primary one. -->
    <Style TargetType="Label">
        <Setter Property="Foreground" Value="{DynamicResource App.InfoForeground}" />
        <Setter Property="Padding" Value="0,0,0,3" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <!-- ===================== Text entry ===================== -->

    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource App.ControlBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource App.ControlForeground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource App.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <!-- WPF already reserves a generous line box inside a text box, so the vertical
             padding here is modest; more just makes every field taller for nothing. -->
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="CaretBrush" Value="{DynamicResource App.ControlForeground}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource App.SelectionBackground}" />
        <Setter Property="SpellCheck.IsEnabled" Value="True" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="MinHeight" Value="{StaticResource App.ControlHeight}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Shell"
                            CornerRadius="{StaticResource App.CornerRadius}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      Focusable="False"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <!--
                            A text box shows a caret when focused, but a caret is invisible to
                            someone at 300% magnification looking elsewhere on the screen.
                            The thick coloured border is what makes the focused field findable.
                        -->
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Shell" Property="BorderBrush" Value="{DynamicResource App.FocusBrush}" />
                            <Setter TargetName="Shell" Property="BorderThickness" Value="{DynamicResource App.FocusBorderThickness}" />
                        </Trigger>
                        <Trigger Property="IsReadOnly" Value="True">
                            <Setter TargetName="Shell" Property="Background" Value="{DynamicResource App.PanelBackground}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.6" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        The drop-down is fully templated rather than just recoloured. The stock WPF
        template paints its own grey gradient chrome that ignores Background and
        BorderBrush, so a themed application ends up with one control that looks like
        it came from a different decade.

        Templating a ComboBox does not affect its automation peer, so the screen reader
        still sees an ordinary combo box with the same keyboard behaviour.
    -->
    <ControlTemplate x:Key="ComboBoxSurface" TargetType="ToggleButton">
        <Border Background="Transparent" />
    </ControlTemplate>

    <Style TargetType="ComboBox">
        <Setter Property="Background" Value="{DynamicResource App.ControlBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource App.ControlForeground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource App.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,9" />
        <Setter Property="MinHeight" Value="{StaticResource App.ControlHeight}" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="Shell"
                                CornerRadius="{StaticResource App.CornerRadius}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" />

                        <!-- Covers the whole control so a click anywhere opens the list. -->
                        <ToggleButton Template="{StaticResource ComboBoxSurface}"
                                      Focusable="False"
                                      ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                                  RelativeSource={RelativeSource TemplatedParent}}" />

                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Center"
                                          IsHitTestVisible="False" />

                        <!-- The chevron, drawn rather than set as a glyph so it scales. -->
                        <Path x:Name="Arrow"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Center"
                              Margin="0,0,14,0"
                              Data="M 0,0 L 5,5 L 10,0"
                              Stroke="{DynamicResource App.InfoForeground}"
                              StrokeThickness="2"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              IsHitTestVisible="False" />

                        <Popup x:Name="PART_Popup"
                               AllowsTransparency="True"
                               Placement="Bottom"
                               Focusable="False"
                               PopupAnimation="None"
                               IsOpen="{Binding IsDropDownOpen,
                                        RelativeSource={RelativeSource TemplatedParent}}">
                            <Border CornerRadius="{StaticResource App.CornerRadius}"
                                    Background="{DynamicResource App.ControlBackground}"
                                    BorderBrush="{DynamicResource App.Border}"
                                    BorderThickness="1"
                                    Margin="0,3,0,0"
                                    MinWidth="{Binding ActualWidth,
                                               RelativeSource={RelativeSource TemplatedParent}}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <ScrollViewer Padding="4">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Shell" Property="BorderBrush" Value="{DynamicResource App.FocusBrush}" />
                            <Setter TargetName="Shell" Property="BorderThickness" Value="{DynamicResource App.FocusBorderThickness}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Shell" Property="BorderBrush" Value="{DynamicResource App.HeadingForeground}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.6" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource App.ControlForeground}" />
        <Setter Property="Padding" Value="12,9" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Shell"
                            CornerRadius="4"
                            Background="Transparent"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Shell" Property="Background" Value="{DynamicResource App.SelectionBackground}" />
                            <Setter Property="Foreground" Value="{DynamicResource App.SelectionForeground}" />
                            <Setter Property="TextElement.Foreground" Value="{DynamicResource App.SelectionForeground}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource App.Foreground}" />
        <Setter Property="Padding" Value="8,0,0,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource AccessibleFocusVisual}" />
    </Style>

    <Style TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource App.Foreground}" />
        <Setter Property="Padding" Value="8,0,0,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource AccessibleFocusVisual}" />
    </Style>

    <!--
        The slider is templated so it stops looking like a Windows 2000 control next to
        everything else. The filled part of the track uses a colour that clears 3 to 1
        against the page, because that fill is the only visual cue to the value.

        Tick marks are left out: they were visual noise, and the value is spelled out in
        words underneath every slider in this application anyway.
    -->
    <Style x:Key="SliderFill" TargetType="RepeatButton">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Height="6" CornerRadius="3" VerticalAlignment="Center"
                            Background="{DynamicResource App.HeadingForeground}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        The unfilled half of the track. Declared here rather than reusing the scroll
        bar's page button, because that one is defined further down the file and a
        StaticResource cannot look forward.
    -->
    <Style x:Key="SliderTrackRest" TargetType="RepeatButton">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Slider">
        <Setter Property="Foreground" Value="{DynamicResource App.HeadingForeground}" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Border x:Name="FocusRing"
                            CornerRadius="{StaticResource App.CornerRadius}"
                            BorderBrush="{DynamicResource App.FocusBrush}"
                            BorderThickness="0"
                            Background="Transparent"
                            Padding="4">
                        <Grid>
                            <Border Height="6" CornerRadius="3" VerticalAlignment="Center"
                                    Background="{DynamicResource App.PanelBackground}"
                                    BorderBrush="{DynamicResource App.Border}"
                                    BorderThickness="1" />

                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge"
                                                  Style="{StaticResource SliderFill}" />
                                </Track.DecreaseRepeatButton>

                                <Track.Thumb>
                                    <Thumb Width="22" Height="22" OverridesDefaultStyle="True">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="{DynamicResource App.ControlBackground}"
                                                         Stroke="{DynamicResource App.HeadingForeground}"
                                                         StrokeThickness="3" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>

                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge"
                                                  Style="{StaticResource SliderTrackRest}" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusRing" Property="BorderThickness"
                                    Value="{DynamicResource App.FocusBorderThickness}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.6" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Buttons ===================== -->

    <!-- The ordinary, secondary button: outlined, no fill. -->
    <Style TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource App.Foreground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource App.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <!-- A large target helps anyone using a magnifier, where the pointer is hard to place. -->
        <Setter Property="Padding" Value="18,9" />
        <Setter Property="MinWidth" Value="104" />
        <Setter Property="MinHeight" Value="{StaticResource App.ControlHeight}" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Shell"
                            CornerRadius="{StaticResource App.CornerRadius}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Shell" Property="BorderBrush" Value="{DynamicResource App.FocusBrush}" />
                            <Setter TargetName="Shell" Property="BorderThickness" Value="{DynamicResource App.FocusBorderThickness}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Shell" Property="Background" Value="{DynamicResource App.SelectionBackground}" />
                            <Setter Property="Foreground" Value="{DynamicResource App.SelectionForeground}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Shell" Property="Background" Value="{DynamicResource App.AccentBackground}" />
                            <Setter Property="Foreground" Value="{DynamicResource App.AccentForeground}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        The one button that does the main thing on the screen: filled, so a new user
        can see where to start without reading every label first.
    -->
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{DynamicResource App.PrimaryButtonBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource App.PrimaryButtonForeground}" />
        <!-- A darker outline than the fill, so the button's edge is findable on a
             white page even when the fill itself is a light brand colour. -->
        <Setter Property="BorderBrush" Value="{DynamicResource App.PrimaryButtonBorder}" />
    </Style>

    <!-- ===================== Lists ===================== -->

    <Style TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource App.Foreground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource App.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <!-- Keeps the selected row scrolled into view, which Magnifier then follows. -->
        <Setter Property="VirtualizingPanel.ScrollUnit" Value="Item" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <Border CornerRadius="{StaticResource App.CornerRadius.Large}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            SnapsToDevicePixels="True">
                        <ScrollViewer Focusable="False" Padding="{TemplateBinding Padding}">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        A list with no container around it, for the main record list and the sidebar.
        A bordered box around a list that fills most of the window just draws a frame
        round the whole page; the rows carry their own shape.
    -->
    <Style x:Key="PlainList" TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style TargetType="ListBoxItem">
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="Margin" Value="0,0,0,3" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid>
                        <Border x:Name="Shell"
                                CornerRadius="{StaticResource App.CornerRadius}"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="{DynamicResource App.FocusBorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter />
                        </Border>

                        <!-- A bar down the left edge marks the selected row by shape as
                             well as by colour, which survives a colour-blind reader and
                             a black-and-white printout of a screenshot. -->
                        <Border x:Name="Marker"
                                Width="5" HorizontalAlignment="Left"
                                Margin="0,3"
                                CornerRadius="3"
                                Background="{DynamicResource App.RowMarker}"
                                Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Shell" Property="Background" Value="{DynamicResource App.RowSelectionBackground}" />
                            <Setter TargetName="Marker" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="{DynamicResource App.RowSelectionForeground}" />
                            <Setter Property="TextElement.Foreground" Value="{DynamicResource App.RowSelectionForeground}" />
                        </Trigger>
                        <!--
                            Selection and keyboard focus are drawn differently on purpose.
                            A screen-reader user arrowing through a list needs to be able to
                            tell "this row is highlighted" from "this row has the keyboard".
                        -->
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Shell" Property="BorderBrush" Value="{DynamicResource App.FocusBrush}" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsSelected" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Shell" Property="Background" Value="{DynamicResource App.PanelBackground}" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        The table is dressed to match the list: no heavy grid, rows separated by a
        hairline, and the selected row carrying the same pale fill and marker bar.
        Its own border is left off because the view wraps it in a rounded one.
    -->
    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource App.Foreground}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="RowBackground" Value="Transparent" />
        <!-- The rows are told apart by their separators, not by stripes. Stripes in a
             tint close to the selection colour make the selected row hard to pick out. -->
        <Setter Property="AlternatingRowBackground" Value="Transparent" />
        <Setter Property="GridLinesVisibility" Value="None" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="CanUserDeleteRows" Value="False" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="SelectionMode" Value="Extended" />
        <Setter Property="SelectionUnit" Value="FullRow" />
        <Setter Property="RowHeaderWidth" Value="0" />
        <Setter Property="ColumnHeaderHeight" Value="46" />
    </Style>

    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource App.HeadingForeground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource App.Border}" />
        <!-- One rule under the whole header, instead of a box around every title. -->
        <Setter Property="BorderThickness" Value="0,0,0,2" />
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style TargetType="DataGridRow">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource App.Foreground}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridRow">
                    <Border x:Name="Shell"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{DynamicResource App.Border}"
                            BorderThickness="0,0,0,1"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <DataGridCellsPresenter
                                ItemsPanel="{TemplateBinding ItemsPanel}"
                                SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />

                            <!-- The same marker the list uses for a selected row. -->
                            <Border x:Name="Marker"
                                    Width="5" HorizontalAlignment="Left"
                                    Background="{DynamicResource App.RowMarker}"
                                    Visibility="Collapsed" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Shell" Property="Background" Value="{DynamicResource App.RowSelectionBackground}" />
                            <Setter TargetName="Marker" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsSelected" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Shell" Property="Background" Value="{DynamicResource App.PanelBackground}" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="DataGridCell">
        <Setter Property="Padding" Value="14,11" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource App.Foreground}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border x:Name="Shell"
                            Background="Transparent"
                            BorderBrush="{DynamicResource App.FocusBrush}"
                            BorderThickness="0"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Shell" Property="BorderThickness" Value="{DynamicResource App.FocusBorderThickness}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <!--
                This trigger is doing real work. WPF's own DataGridCell theme style has
                an IsSelected trigger that forces the text to the system highlight
                colour, which is white. A theme style's trigger outranks a value the
                cell merely inherits from its row, so without this the selected row's
                text came out white on the pale selection and was nearly invisible.
            -->
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource App.RowSelectionForeground}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===================== Scroll bars ===================== -->

    <Style x:Key="ScrollPageButton" TargetType="RepeatButton">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ScrollThumb" TargetType="Thumb">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border CornerRadius="5" Margin="3"
                            Background="{DynamicResource App.ScrollThumb}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate x:Key="VerticalScrollBar" TargetType="ScrollBar">
        <Grid Background="{DynamicResource App.ScrollTrack}">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource ScrollPageButton}" />
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Style="{StaticResource ScrollThumb}" />
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource ScrollPageButton}" />
                </Track.IncreaseRepeatButton>
            </Track>
        </Grid>
    </ControlTemplate>

    <ControlTemplate x:Key="HorizontalScrollBar" TargetType="ScrollBar">
        <Grid Background="{DynamicResource App.ScrollTrack}">
            <Track x:Name="PART_Track">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageLeftCommand" Style="{StaticResource ScrollPageButton}" />
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Style="{StaticResource ScrollThumb}" />
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageRightCommand" Style="{StaticResource ScrollPageButton}" />
                </Track.IncreaseRepeatButton>
            </Track>
        </Grid>
    </ControlTemplate>

    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="16" />
        <Setter Property="MinWidth" Value="16" />
        <Setter Property="Template" Value="{StaticResource VerticalScrollBar}" />
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Height" Value="16" />
                <Setter Property="MinHeight" Value="16" />
                <Setter Property="Template" Value="{StaticResource HorizontalScrollBar}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===================== Chrome ===================== -->

    <Style TargetType="Menu">
        <Setter Property="Background" Value="{DynamicResource App.PanelBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource App.PanelForeground}" />
        <Setter Property="Padding" Value="6,4" />
    </Style>

    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource App.PanelForeground}" />
        <Setter Property="Padding" Value="10,6" />
    </Style>

    <Style TargetType="ContextMenu">
        <Setter Property="Background" Value="{DynamicResource App.PanelBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource App.PanelForeground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource App.Border}" />
    </Style>

    <Style TargetType="StatusBar">
        <Setter Property="Background" Value="{DynamicResource App.PanelBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource App.PanelForeground}" />
        <Setter Property="Padding" Value="14,9" />
    </Style>

    <Style TargetType="GroupBox">
        <Setter Property="Foreground" Value="{DynamicResource App.Foreground}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource App.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="Margin" Value="0,0,0,14" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GroupBox">
                    <Border CornerRadius="{StaticResource App.CornerRadius.Large}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            SnapsToDevicePixels="True">
                        <DockPanel>
                            <!-- The header is set in the heading colour with a hairline
                                 under it, rather than sitting in a filled band. The band
                                 added weight without adding meaning. -->
                            <StackPanel DockPanel.Dock="Top">
                                <ContentPresenter ContentSource="Header"
                                                  Margin="18,14,18,0"
                                                  TextBlock.FontWeight="SemiBold"
                                                  TextBlock.Foreground="{DynamicResource App.HeadingForeground}" />
                                <Border Height="1" Margin="18,11,18,0"
                                        Background="{DynamicResource App.Border}" />
                            </StackPanel>
                            <ContentPresenter Margin="{TemplateBinding Padding}" />
                        </DockPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Separator">
        <Setter Property="Background" Value="{DynamicResource App.Border}" />
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{DynamicResource App.PanelBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource App.PanelForeground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource App.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,9" />
    </Style>

    <Style TargetType="ScrollViewer">
        <Setter Property="Background" Value="Transparent" />
        <!-- Lets the keyboard reach a long form without a mouse wheel. -->
        <Setter Property="PanningMode" Value="VerticalOnly" />
    </Style>

    <Style TargetType="GridSplitter">
        <Setter Property="Background" Value="{DynamicResource App.Border}" />
    </Style>

</ResourceDictionary>
